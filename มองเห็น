local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer

local enabled = false
local visuals = {}

-- ปรับระยะที่อยากเห็น (เพิ่มได้อีก)
local MAX_DISTANCE = 1000

-- ===== GUI =====
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.Name = "FarVisionGUI"

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 110)
frame.Position = UDim2.new(0, 50, 0, 100)
frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
Instance.new("UICorner", frame)

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1,0,0,30)
title.BackgroundTransparency = 1
title.Text = "Far Player Vision"
title.TextColor3 = Color3.new(1,1,1)

local button = Instance.new("TextButton", frame)
button.Size = UDim2.new(0.8,0,0,40)
button.Position = UDim2.new(0.1,0,0.5,0)
button.Text = "OFF"
button.BackgroundColor3 = Color3.fromRGB(200,0,0)
button.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", button)

-- ===== ลาก GUI =====
local dragging, dragInput, dragStart, startPos
frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

frame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- ===== ฟังก์ชันสร้าง =====
local function createVisual(plr, char)
	if plr == player then return end
	
	local root = char:WaitForChild("HumanoidRootPart", 3)
	local head = char:FindFirstChild("Head")
	if not root or not head then return end

	-- Highlight
	local h = Instance.new("Highlight")
	h.FillColor = plr.TeamColor.Color
	h.OutlineColor = Color3.new(1,1,1)
	h.FillTransparency = 0.5
	h.Parent = char

	-- NameTag
	local bill = Instance.new("BillboardGui")
	bill.Size = UDim2.new(0, 120, 0, 40)
	bill.StudsOffset = Vector3.new(0, 2.5, 0)
	bill.AlwaysOnTop = true
	bill.Adornee = head
	bill.Parent = char

	local text = Instance.new("TextLabel", bill)
	text.Size = UDim2.new(1,0,1,0)
	text.BackgroundTransparency = 1
	text.TextColor3 = Color3.new(1,1,1)
	text.TextStrokeTransparency = 0
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true

	visuals[plr] = {
		Highlight = h,
		Name = text,
		Root = root
	}
end

-- ===== ลบ =====
local function clearAll()
	for _, v in pairs(visuals) do
		if v.Highlight then v.Highlight:Destroy() end
		if v.Name and v.Name.Parent then v.Name.Parent:Destroy() end
	end
	visuals = {}
end

-- ===== อัปเดตระยะ =====
game:GetService("RunService").RenderStepped:Connect(function()
	if not enabled then return end
	
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	
	for plr, v in pairs(visuals) do
		if plr.Character and v.Root then
			local dist = (myRoot.Position - v.Root.Position).Magnitude
			
			if dist <= MAX_DISTANCE then
				v.Name.Text = plr.Name .. " | " .. math.floor(dist) .. "m"
				v.Name.Parent.Enabled = true
				v.Highlight.Enabled = true
			else
				v.Name.Parent.Enabled = false
				v.Highlight.Enabled = false
			end
		end
	end
end)

-- ===== เปิดใช้งาน =====
local function apply()
	for _, plr in pairs(Players:GetPlayers()) do
		if plr.Character then
			createVisual(plr, plr.Character)
		end
		
		plr.CharacterAdded:Connect(function(char)
			if enabled then
				createVisual(plr, char)
			end
		end)
	end
end

-- ===== ปุ่ม =====
button.MouseButton1Click:Connect(function()
	enabled = not enabled
	
	if enabled then
		button.Text = "ON"
		button.BackgroundColor3 = Color3.fromRGB(0,200,0)
		apply()
	else
		button.Text = "OFF"
		button.BackgroundColor3 = Color3.fromRGB(200,0,0)
		clearAll()
	end
end)
